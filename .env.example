# Entorno y Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Base de Datos MySQL 8.0 (Configurar Parameter Group en America/Bogota y utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=cemcop_entregas_db
DB_CONNECTION_LIMIT=10

# Redis (Upstash TLS o Redis local; si se omite usa fallback en memoria para desarrollo)
REDIS_URL=

# JWT y Sesiones
JWT_ACCESS_SECRET=cambia_este_secreto_access_minimo_32_caracteres_seguros
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_minimo_32_caracteres_seguros
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=43200

# Almacenamiento (s3 | local)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.local-storage
AWS_REGION=us-east-2
S3_ASSETS_BUCKET=cemcop-entregas-assets-839858225814

# Colas SQS (Opcional en desarrollo local; si se omite ejecuta workers en proceso)
SQS_REPORTS_QUEUE_URL=
SQS_EMAIL_QUEUE_URL=

# Notificaciones Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@cemcop.net
SMTP_PASS=
SMTP_FROM="CEMCOP Entregas <no-reply@cemcop.net>"

# Observabilidad Sentry
SENTRY_DSN=

